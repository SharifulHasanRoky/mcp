# ============================================================
# 🚀 MOTHER MCP - Environment Configuration
# ============================================================
# Copy this to .env and fill in your API keys.
# You DON'T need all keys - only add what you use!
# ============================================================

# ========================
# 📢 FACEBOOK (META) ADS
# ========================
# Get from: https://developers.facebook.com
FB_ADS_ACCESS_TOKEN=
FB_ADS_ACCOUNT_ID=
# FB_ADS_APP_ID=
# FB_ADS_APP_SECRET=

# ========================
# 📢 GOOGLE ADS
# ========================
# Get from: https://developers.google.com/google-ads/api
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ========================
# 📢 TIKTOK ADS
# ========================
# Get from: https://business-api.tiktok.com/portal/
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
# TIKTOK_ADS_APP_ID=
# TIKTOK_ADS_SECRET=

# ========================
# 📢 PINTEREST ADS
# ========================
# Get from: https://developers.pinterest.com/
PINTEREST_ADS_ACCESS_TOKEN=
PINTEREST_ADS_ACCOUNT_ID=

# ========================
# 📢 LINKEDIN ADS
# ========================
# Get from: https://www.linkedin.com/developers/
LINKEDIN_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_ACCOUNT_ID=

# ========================
# 📢 X (TWITTER) ADS
# ========================
# Get from: https://developer.x.com
X_ADS_API_KEY=
X_ADS_API_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
X_ADS_ACCOUNT_ID=

# ========================
# 📊 GOOGLE ANALYTICS 4
# ========================
# Get from: https://console.cloud.google.com
GA4_ACCESS_TOKEN=
GA4_PROPERTY_ID=

# ========================
# 📊 GOOGLE TAG MANAGER
# ========================
# Get from: https://tagmanager.google.com
GTM_ACCESS_TOKEN=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=

# ========================
# 📊 LOOKER STUDIO
# ========================
# Get from: https://console.cloud.google.com
LOOKER_ACCESS_TOKEN=

# ========================
# 📋 CLICKUP
# ========================
# Get from: ClickUp Settings → Apps → API Token
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# ========================
# 📋 NOTION
# ========================
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=

# ========================
# 📋 GOOGLE DOCS & SHEETS
# ========================
# Same OAuth token works for both (needs docs + sheets + drive scopes)
GOOGLE_DOCS_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN=

# ========================
# 🤖 AI TOOLS
# ========================
# Add whichever AI providers you use:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
STABILITY_API_KEY=
